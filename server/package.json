{
  "name": "screenplay-collab-server",
  "version": "2.0.0",
  "description": "Real-time collaboration server for screenplay editor",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js"
    ],
    "testTimeout": 15000
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.117",
    "mongoose": "^8.0.0",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0",
    "ws": "^8.20.0",
    "y-mongodb-provider": "^0.2.1",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
